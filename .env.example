# MongoDB Atlas
MONGODB_URI=
MONGODB_DB=dsahub

# Auth.js / GitHub OAuth (server-only secrets)
AUTH_SECRET=
AUTH_GITHUB_ID=
AUTH_GITHUB_SECRET=
AUTH_URL=http://localhost:3000

# Optional: enable only when running behind a trusted reverse proxy
# AUTH_TRUST_HOST=true

# Web app
APP_PORT=3000
NEXT_PUBLIC_APP_URL=http://localhost:3000

# GitHub App (server-side only; never expose to NEXT_PUBLIC_* variables)
# Create an app with Repository permissions: Contents = Read and write.
GITHUB_APP_ID=
# Paste the PEM private key here. Literal \\n line breaks are supported.
GITHUB_APP_PRIVATE_KEY=
