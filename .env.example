# MongoDB Atlas
MONGODB_URI=
MONGODB_DB=dsahub

# Auth.js / GitHub OAuth (server-only secrets)
AUTH_SECRET=
AUTH_GITHUB_ID=
AUTH_GITHUB_SECRET=
AUTH_URL=http://localhost:3000

# Optional: enable only when running behind a trusted reverse proxy
# AUTH_TRUST_HOST=true

# Web app
APP_PORT=3000
NEXT_PUBLIC_APP_URL=http://localhost:3000
